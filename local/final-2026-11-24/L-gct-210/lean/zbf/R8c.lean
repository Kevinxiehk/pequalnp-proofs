    (m2 : Fin 5) (hm21 : ξ m2 / κ2 m2 = ξ a'' / κ2 a'') (hm22 : ξ' m2 / κ3 m2 = ξ' b'' / κ3 b'')
    (B12 Q12 B13 Q13 B23 Q23 : Finset (Fin 5))
