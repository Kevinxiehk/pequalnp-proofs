      ring
    · show (0 * (-2) + (-1) * (-2) + (-1) * (-1) + (1)) / κs 1 (cc (Sum.inl 0)) = ((-4) * j) / (c * κs 0 (cc (Sum.inl 0)))
      rw [a1, div_eq_div_iff (mul_ne_zero (mul_ne_zero hj0 hc) n0) (mul_ne_zero hc n0)]
      linear_combination ((4) * c * κs 0 (cc (Sum.inl 0))) * hj
    · show (0 * (-2) + 1 * (-2) + 0 * (-1) + 0) / κs 1 (cc (Sum.inl 1)) = ((-2)) / (c * κs 0 (cc (Sum.inl 1)))
