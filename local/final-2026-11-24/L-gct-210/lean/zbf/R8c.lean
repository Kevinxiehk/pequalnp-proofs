def T1Rest3 : Prop :=
  ∀ L : Submodule ℂ (Fin 5 × Fin 5 → ℂ), Lev 5 L → Module.finrank ℂ L = 9 →
    ∀ r1 r2 r3 : Fin 5, r1 ≠ r2 → r1 ≠ r3 → r2 ≠ r3 → ZF L r1 → ZF L r2 → ZF L r3 →
    Module.finrank ℂ (rowsZeroS L {r1, r2}) = 2 →
    Module.finrank ℂ (rowsZeroS L {r1, r3}) = 2 →
    Module.finrank ℂ (rowsZeroS L {r2, r3}) = 2 →
    (PairII L r1 r2 ∧ PairII L r1 r3 ∧ PairII L r2 r3) → rowsZeroS L {r1, r2, r3} ≠ ⊥

theorem t1rest2_of_rest3 (h : T1Rest3) : T1Rest2 := by
  intro L hL h9 r1 r2 r3 h12 h13 h23 z1 z2 z3 x12 x13 x23 hII h0
  have P12 := pair_I_or_II hL r1 r2 h12 (pair_min h9 r1 r2 x12) z1 z2
  have P13 := pair_I_or_II hL r1 r3 h13 (pair_min h9 r1 r3 x13) z1 z3
  have P23 := pair_I_or_II hL r2 r3 h23 (pair_min h9 r2 r3 x23) z2 z3
  rcases hII with ⟨p12, p13⟩ | ⟨p12, p23⟩ | ⟨p13, p23⟩
  · rcases P23 with q23 | q23
    · exact t1_IIi hL h9 r1 r2 r3 h12 h13 h23 z1 z2 z3 p12 p13 q23 h0
    · exact h L hL h9 r1 r2 r3 h12 h13 h23 z1 z2 z3 x12 x13 x23 ⟨p12, p13, q23⟩ h0
  · rcases P13 with q13 | q13
    · exact t1_IIi hL h9 r2 r1 r3 h12.symm h23 h13 z2 z1 z3 (pairII_swap r1 r2 p12) p23 q13
        (by rw [set3_rot]; exact h0)
    · exact h L hL h9 r1 r2 r3 h12 h13 h23 z1 z2 z3 x12 x13 x23 ⟨p12, q13, p23⟩ h0
  · rcases P12 with q12 | q12
    · exact t1_IIi hL h9 r3 r1 r2 h13.symm h23.symm h12 z3 z1 z2 (pairII_swap r1 r3 p13)
        (pairII_swap r2 r3 p23) q12 (by rw [set3_rot2]; exact h0)
    · exact h L hL h9 r1 r2 r3 h12 h13 h23 z1 z2 z3 x12 x13 x23 ⟨q12, p13, p23⟩ h0

theorem t1_of_rest3 (h : T1Rest3) : T1Hyp := t1_of_rest2 (t1rest2_of_rest3 h)

theorem c7_split (κ κ' ν ν' : Fin 5 → ℂ) (hκ0 : ∀ j, κ j ≠ 0) (hκ'0 : ∀ j, κ' j ≠ 0)
    (a b : Fin 5) (hcl : TypeCl κ κ' ν ν' a b) (Qa Qb : Finset (Fin 5))
    (hQa : ∀ m, m ∈ Qa ↔ ν' m / κ' m = ν' a / κ' a)
    (hQb : ∀ m, m ∈ Qb ↔ ν m / κ m = ν b / κ b) (z1 z2 : Fin 5 → ℂ) :
    ∑ m, z1 m * ν m = ν a / κ a * ∑ m, z1 m * κ m +
      (ν b / κ b - ν a / κ a) * ∑ m ∈ Qb, z1 m * κ m ∧
    ∑ m, z2 m * ν' m = ν' b / κ' b * ∑ m, z2 m * κ' m +
      (ν' a / κ' a - ν' b / κ' b) * ∑ m ∈ Qa, z2 m * κ' m := by
  obtain ⟨hab, hab', hσ, hall⟩ := hcl
  have hν : ∀ m, ν m = ν m / κ m * κ m := fun m => (div_mul_cancel₀ _ (hκ0 m)).symm
  have hν' : ∀ m, ν' m = ν' m / κ' m * κ' m := fun m => (div_mul_cancel₀ _ (hκ'0 m)).symm
  have hQ1 : ∑ m ∈ Qb, z1 m * κ m = ∑ m, if m ∈ Qb then z1 m * κ m else 0 := by
    rw [Finset.sum_ite_mem, Finset.univ_inter]
  have hQ2 : ∑ m ∈ Qa, z2 m * κ' m = ∑ m, if m ∈ Qa then z2 m * κ' m else 0 := by
    rw [Finset.sum_ite_mem, Finset.univ_inter]
  constructor
  · rw [hQ1, Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun m _ => ?_
    rcases hall m with h | h | h
    · rw [if_neg (fun hm => hab (h.1.symm.trans ((hQb m).mp hm))), hν m, h.1]
      ring
    · rw [if_pos ((hQb m).mpr h.1), hν m, h.1]
      ring
    · rw [if_neg (fun hm => hab (h.1.symm.trans ((hQb m).mp hm))), hν m, h.1]
      ring
  · rw [hQ2, Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun m _ => ?_
    rcases hall m with h | h | h
    · rw [if_pos ((hQa m).mpr h.2.1), hν' m, h.2.1]
      ring
    · rw [if_neg (fun hm => hab' (((hQa m).mp hm).symm.trans h.2.1)), hν' m, h.2.1]
      ring
    · rw [if_neg (fun hm => hab' (((hQa m).mp hm).symm.trans h.2.1)), hν' m, h.2.1]
      ring

theorem typeII_J (κ κ' ν ν' : Fin 5 → ℂ) (hκ0 : ∀ j, κ j ≠ 0) (hκ'0 : ∀ j, κ' j ≠ 0)
    (a b : Fin 5) (hcl : TypeCl κ κ' ν ν' a b) (hκ1 : dotL κ 1 = 1) (hκ'1 : dotL κ' 1 = 1)
    (hν1 : dotL ν 1 + dotL ν' 1 = 0) (m0 : Fin 5)
    (hm0 : ν m0 / κ m0 = ν a / κ a ∧ ν' m0 / κ' m0 = ν' b / κ' b) (Qa Qb : Finset (Fin 5))
    (hQa : ∀ m, m ∈ Qa ↔ ν' m / κ' m = ν' a / κ' a)
    (hQb : ∀ m, m ∈ Qb ↔ ν m / κ m = ν b / κ b) :
    (∑ m ∈ Qb, κ m + ∑ m ∈ Qa, κ' m) * (κ' m0 / κ m0 + κ' a / κ a) = κ' a / κ a := by
  obtain ⟨e1, e2⟩ := c7_split κ κ' ν ν' hκ0 hκ'0 a b hcl Qa Qb hQa hQb 1 1
  have hcl0 := hcl
  obtain ⟨hab, hab', hσ, hall⟩ := hcl0
  have hcorner : ν a / κ a + ν' a / κ' a ≠ 0 ∧
      (ν a / κ a + ν' b / κ' b) ^ 2 = -(ν a / κ a + ν' a / κ' a) ^ 2 ∧
      κ' a / κ a * (ν a / κ a + ν' a / κ' a) +
        κ' m0 / κ m0 * (ν a / κ a + ν' b / κ' b) = 0 := by
    rcases hall m0 with h | h | h
    · exact absurd (hm0.2.symm.trans h.2.1) (Ne.symm hab')
    · exact absurd (hm0.1.symm.trans h.1) hab
    · exact ⟨h.2.2.1, h.2.2.2.2.1, h.2.2.2.2.2⟩
  obtain ⟨hsa, hsq, hlin⟩ := hcorner
  have hsc : ν a / κ a + ν' b / κ' b ≠ 0 := by
    intro h0
    rw [h0] at hsq
    apply hsa
    have h1 : (ν a / κ a + ν' a / κ' a) ^ 2 = 0 := by linear_combination hsq
    exact (pow_eq_zero_iff two_ne_zero).mp h1
  rw [dotL_apply, dotL_apply] at hν1
  rw [dotL_apply] at hκ1 hκ'1
  simp only [Pi.one_apply, one_mul] at e1 e2 hν1 hκ1 hκ'1
  have E : (ν b / κ b - ν a / κ a) * (∑ m ∈ Qb, κ m + ∑ m ∈ Qa, κ' m) =
      -(ν a / κ a + ν' b / κ' b) := by
    linear_combination hν1 - e1 - e2 - (ν a / κ a) * hκ1 - (ν' b / κ' b) * hκ'1 -
      (∑ m ∈ Qa, κ' m) * hσ
  have key : (ν a / κ a + ν' b / κ' b) * ((∑ m ∈ Qb, κ m + ∑ m ∈ Qa, κ' m) *
      (κ' m0 / κ m0 + κ' a / κ a) - κ' a / κ a) = 0 := by
    linear_combination (∑ m ∈ Qb, κ m + ∑ m ∈ Qa, κ' m) * hlin - (κ' a / κ a) * E -
      (κ' a / κ a * (∑ m ∈ Qb, κ m + ∑ m ∈ Qa, κ' m)) * hσ
  exact sub_eq_zero.mp ((mul_eq_zero.mp key).resolve_left hsc)

theorem unit_split {ω c' j : ℂ} (hω : ω ^ 2 = -c' ^ 2) (hj : j * j = -1) :
    ω = j * c' ∨ ω = -j * c' := by
  have h : (ω - j * c') * (ω + j * c') = 0 := by
    linear_combination hω - c' ^ 2 * hj
  rcases mul_eq_zero.mp h with h1 | h1
  · exact Or.inl (by linear_combination h1)
  · exact Or.inr (by linear_combination h1)

