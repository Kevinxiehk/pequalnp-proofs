theorem f1_alg (j c c' A1 A2 A3 : ℂ) (hj : j * j = -1) (hc : c ≠ 0)
    (E1 : A1 + A2 + A3 = 1) (E2 : c * (j * A1 + A2 - A3) = 1) (E3 : c' * (A1 + j * A2 - A3) = 1)
    (E4 : (A3 + c * A2) * (1 + j) = 1) (E5 : (A3 + c' * A1) * (1 + j) = 1)
    (E6 : (c * A2 + c' * A1) * (1 + j) = 1) : False := by
  have e7 : 2 * A3 * (1 + j) = 1 := by linear_combination E4 + E5 - E6
  have hA3 : 4 * A3 = 1 - j := by linear_combination (1 - j) * e7 + 2 * A3 * hj
  have hX : 2 * (c * A2 - A3) = 0 := by
    linear_combination (1 - j) * E4 - (1 - j) * e7 + (c * A2 - A3) * hj
  have hcA2 : c * A2 = A3 := by linear_combination hX / 2
  have hY : 2 * (c' * A1 - A3) = 0 := by
    linear_combination (1 - j) * E5 - (1 - j) * e7 + (c' * A1 - A3) * hj
  have hc'A1 : c' * A1 = A3 := by linear_combination hY / 2
  have G1 : A3 * (j * c + c' - c * c') = c' := by
    linear_combination c' * E2 - c * j * hc'A1 - c' * hcA2
  have G2 : A3 * (c + j * c' - c * c') = c := by
    linear_combination c * E3 - c * hc'A1 - j * c' * hcA2
  have G3 : A3 * (c + c' + c * c') = c * c' := by
    linear_combination c * c' * E1 - c * hc'A1 - c' * hcA2
  have h8 : (c - c') * (A3 * (j - 1) + 1) = 0 := by linear_combination G1 - G2
  have h9 : A3 * (j - 1) + 1 ≠ 0 := by
    intro h
    have t : 2 * j + 4 = 0 := by linear_combination 4 * h - (j - 1) * hA3 + hj
    have t5 : (5 : ℂ) = 0 := by linear_combination ((2 - j) / 2) * t + hj
    norm_num at t5
  have hcc : c' = c := by
    have e := (mul_eq_zero.mp h8).resolve_right h9
    linear_combination -e
  rw [hcc] at G2 G3
  have K1 : A3 * (1 + j - c) = 1 := by
    have e : c * (A3 * (1 + j - c) - 1) = 0 := by linear_combination G2
    exact sub_eq_zero.mp ((mul_eq_zero.mp e).resolve_left hc)
  have K2 : A3 * (2 + c) = c := by
    have e : c * (A3 * (2 + c) - c) = 0 := by linear_combination G3
    exact sub_eq_zero.mp ((mul_eq_zero.mp e).resolve_left hc)
  have L1 : c * (1 - j) = -2 := by linear_combination -4 * K1 + (1 + j - c) * hA3 - hj
  have L2 : 4 * c = -2 * j := by linear_combination -4 * K2 + (2 + c) * hA3 + L1
  have t40 : (40 : ℂ) = 0 := by
    linear_combination (6 + 2 * j) * 4 * L1 - (6 + 2 * j) * (1 - j) * L2 - (6 + 2 * j) * 2 * hj +
      4 * hj
  norm_num at t40

theorem f1_alg2 (j c c' A1 A2 A3 : ℂ) (hj : j * j = -1)
    (E1 : A1 + A2 + A3 = 1) (E2 : c * (j * A1 + A2 - A3) = 1) (E3 : c' * (-A1 + A2 + j * A3) = 1)
    (E4 : (A3 + c * A2) * (1 + j) = 1) (E5 : (A1 + c' * A2) * (1 + j) = 1)
    (E6 : j * (c * A1 + c' * A3) * (1 + j) = 1) : False := by
  have G4 : 2 * A3 = 1 - j - 2 * c * A2 := by
    linear_combination (1 - j) * E4 + (A2 * c + A3) * hj
  have G5 : 2 * A1 = 1 - j - 2 * c' * A2 := by
    linear_combination (1 - j) * E5 + (A1 + A2 * c') * hj
  have H2 : c * (j + A2 * (1 + c - j * c')) = 1 := by
    linear_combination E2 + (c / 2) * hj + (c / 2) * G4 - (c * j / 2) * G5
  have H3 : c' * (j + A2 * (1 + c' - j * c)) = 1 := by
    linear_combination E3 + (c' / 2) * hj - (c' * j / 2) * G4 + (c' / 2) * G5
  have H6 : j * (c + c') - 2 * j * (1 + j) * c * c' * A2 = 1 := by
    linear_combination E6 - (j * (1 + j) * c / 2) * G5 - (j * (1 + j) * c' / 2) * G4 +
      (j * (c + c') / 2) * hj
  have F1 : A2 * (1 - c - c') = j := by
    linear_combination E1 + ((j - 1) / 2) * E4 + ((j - 1) / 2) * E5 +
      (-A1 / 2 - A2 * c / 2 - A2 * c' / 2 - A3 / 2) * hj
  have F2 : (c - c') * (j + A2 * (1 + c + c')) = 0 := by linear_combination H2 - H3
  rcases mul_eq_zero.mp F2 with hcc | hA
  · have hc' : c' = c := by linear_combination -hcc
    rw [hc'] at F1 H6 H2
    have G1c : A2 * (1 - 2 * c) = j := by linear_combination F1
    have H6c : 2 * j * c - 2 * j * (1 + j) * c ^ 2 * A2 = 1 := by linear_combination H6
    have t : (1 : ℂ) = 0 := by
      linear_combination (4*A2*c*j - 2*A2*c - 3*A2*j ^ 2 - 3*A2 - 8*c*j ^ 2 + 2*c*j - 6*c - 3*j ^ 3 -
        7*j ^ 2 - 4*j - 9) * G1c + (-6*A2*j ^ 2 - 4*A2*j - 4*A2 + 4*c*j ^ 2 + 4*c*j - 4*j ^ 2 - 12) * H2 +
        (3*A2*j - 4*A2 - 2*c*j + 2*c + 2*j + 6) * H6c +
        (3*A2 ^ 2 + A2 - 4*c ^ 2*j - 4*c*j + 2*c - 3*j ^ 2 - 7*j - 5) * hj
    norm_num at t
  · have h2 : 2 * A2 = 0 := by linear_combination F1 + hA
    have hA2 : A2 = 0 := by linear_combination h2 / 2
    rw [hA2] at F1
    have hj0 : j = 0 := by linear_combination -F1
    rw [hj0] at hj
    norm_num at hj

theorem sum_three_parts (S1 S2 S3 : Finset (Fin 5)) (f : Fin 5 → ℂ)
    (h : ∀ m, (m ∈ S1 ∧ m ∉ S2 ∧ m ∉ S3) ∨ (m ∉ S1 ∧ m ∈ S2 ∧ m ∉ S3) ∨
      (m ∉ S1 ∧ m ∉ S2 ∧ m ∈ S3)) :
    ∑ m, f m = ∑ m ∈ S1, f m + ∑ m ∈ S2, f m + ∑ m ∈ S3, f m := by
  have e : ∀ m, f m = (if m ∈ S1 then f m else 0) + (if m ∈ S2 then f m else 0) +
      (if m ∈ S3 then f m else 0) := by
    intro m
    rcases h m with ⟨h1, h2, h3⟩ | ⟨h1, h2, h3⟩ | ⟨h1, h2, h3⟩
    · rw [if_pos h1, if_neg h2, if_neg h3]
      ring
    · rw [if_neg h1, if_pos h2, if_neg h3]
      ring
    · rw [if_neg h1, if_neg h2, if_pos h3]
      ring
  calc ∑ m, f m = ∑ m, ((if m ∈ S1 then f m else 0) + (if m ∈ S2 then f m else 0) +
        (if m ∈ S3 then f m else 0)) := Finset.sum_congr rfl (fun m _ => e m)
    _ = ∑ m ∈ S1, f m + ∑ m ∈ S2, f m + ∑ m ∈ S3, f m := by
        rw [Finset.sum_add_distrib, Finset.sum_add_distrib, Finset.sum_ite_mem, Finset.sum_ite_mem,
          Finset.sum_ite_mem, Finset.univ_inter, Finset.univ_inter, Finset.univ_inter]

theorem sum_scale (S : Finset (Fin 5)) (f g : Fin 5 → ℂ) (k : ℂ) (h : ∀ m ∈ S, f m = k * g m) :
    ∑ m ∈ S, f m = k * ∑ m ∈ S, g m := by
  rw [Finset.mul_sum]
  exact Finset.sum_congr rfl h

theorem sum_one_eq (κ : Fin 5 → ℂ) (h : dotL κ 1 = 1) : ∑ m, κ m = 1 := by
  rw [dotL_apply] at h
  simp only [Pi.one_apply, one_mul] at h
  exact h


