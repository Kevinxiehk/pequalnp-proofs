  have hsQ : s ∉ Q12 := fun h => hQB12 s h hsB
  have hpq : p ≠ q := fun h => hpQ (by rw [h]; exact hqQ)
  have hps : p ≠ s := fun h => hpB (by rw [h]; exact hsB)
  have hqs : q ≠ s := fun h => hqB (by rw [h]; exact hsB)
  obtain ⟨j, hjdef⟩ : ∃ j : ℂ, j = κ2 p / κ p / c := ⟨_, rfl⟩
  have hj : j * j = -1 := by
