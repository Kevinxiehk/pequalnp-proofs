  · intro heq
    have hP0 : (Matrix.of (![![((1 / 2) + (1 / 2) * j) / κs 0 (cc (Sum.inl 0)), ((-2)) / κs 0 (cc (Sum.inl 1)), ((5 / 2) + (-1 / 2) * j) / κs 0 (cc (Sum.inl 2))], ![((-5) * j) / (c * κs 0 (cc (Sum.inl 0))), ((-2)) / (c * κs 0 (cc (Sum.inl 1))), ((-2)) / (-c * κs 0 (cc (Sum.inl 2)))], ![((-1) * j ^ 2) / (c' * κs 0 (cc (Sum.inl 0))), ((1 / 2) + (-1 / 2) * j) / (c' * κs 0 (cc (Sum.inl 1))), ((-1 / 2) * j + (1 / 2) * j ^ 2) / (c' * κs 0 (cc (Sum.inl 2)))]] : Fin 3 → Fin 3 → ℂ)).permanent * (c * c' * κs 0 (cc (Sum.inl 0)) * κs 0 (cc (Sum.inl 1)) * κs 0 (cc (Sum.inl 2))) = ((1 / 2) + (-23 / 4) * j + 11 * j ^ 2 + (9 / 4) * j ^ 3) := by
