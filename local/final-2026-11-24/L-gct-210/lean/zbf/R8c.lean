  have hw1 : κ2 p = j * c * κ p ∧ κ2 q = c * κ q ∧ κ2 s = -c * κ s := by
    refine ⟨?_, w12Q q hqQ, w12B s hsB⟩
    rw [hjdef, div_mul_cancel₀ _ hc, div_mul_cancel₀ _ (hκ0 p)]
  have hloc : ∀ t ∈ L, (∀ m, m ≠ p → m ≠ q → m ≠ s →
      t (r1, m) = 0 ∧ t (r2, m) = 0 ∧ t (r3, m) = 0) →
