      rw [b3, div_eq_div_iff (mul_ne_zero (mul_ne_zero hj0 hc') n2) (mul_ne_zero hc' n2)]
      linear_combination (((1 / 2) + (-1 / 2) * j) * c' * κs 0 (cc (Sum.inl 2))) * hj
  · intro i j
    rw [Fin.sum_univ_three]
    rcases fin3_cases i with rfl | rfl | rfl <;> rcases fin3_cases j with rfl | rfl | rfl
    · show ((-1) * (-2) + 1 * (-2) + 0 * (-1) + ((1 / 2) + (1 / 2) * j)) / κs 0 (cc (Sum.inl 0)) = ((1 / 2) + (1 / 2) * j) / κs 0 (cc (Sum.inl 0))
      ring
