theorem typeCl_swap (κ κ' ν ν' : Fin 5 → ℂ) (hκ0 : ∀ j, κ j ≠ 0) (hκ'0 : ∀ j, κ' j ≠ 0)
    (a b : Fin 5) (h : TypeCl κ κ' ν ν' a b) : TypeCl κ' κ ν' ν b a := by
  obtain ⟨hab, hab', hσ, hall⟩ := h
  have hinv : ∀ m, κ m / κ' m = (κ' m / κ m)⁻¹ := fun m => (inv_div _ _).symm
  have hc : κ' a / κ a ≠ 0 := div_ne_zero (hκ'0 a) (hκ0 a)
  have hRb : κ' b / κ b = -(κ' a / κ a) := by
    rcases hall b with h | h | h
    · exact absurd h.1.symm hab
    · exact h.2.2
    · exact absurd h.1.symm hab
  refine ⟨Ne.symm hab', Ne.symm hab, by linear_combination -hσ, fun m => ?_⟩
  rcases hall m with h | h | h
  · right
    left
    refine ⟨h.2.1, h.1, ?_⟩
    rw [hinv, hinv, h.2.2, hRb, inv_neg, neg_neg]
  · left
    refine ⟨h.2.1, h.1, ?_⟩
    rw [hinv, hinv, h.2.2, hRb]
  · right
    right
    obtain ⟨h1, h2, h3, h4, h5, h6⟩ := h
    have hRm : κ' m / κ m ≠ 0 := div_ne_zero (hκ'0 m) (hκ0 m)
    refine ⟨h2, h1, ?_, ?_, ?_, ?_⟩
    · intro h0
      apply h3
      linear_combination h0 + hσ
    · rw [hinv, hinv, inv_pow, inv_pow, h4, hRb, neg_sq, inv_neg]
    · have e : ν' b / κ' b + ν a / κ a = ν a / κ a + ν' b / κ' b := by ring
      have e2 : ν' b / κ' b + ν b / κ b = ν a / κ a + ν' a / κ' a := by linear_combination -hσ
      rw [e, e2]
      exact h5
    · have key : κ' a / κ a * (κ' a / κ a * (ν' b / κ' b + ν a / κ a) -
          κ' m / κ m * (ν' b / κ' b + ν b / κ b)) = 0 := by
        linear_combination (-(κ' m / κ m)) * h6 + (ν a / κ a + ν' b / κ' b) * h4 +
          (κ' a / κ a * (κ' m / κ m)) * hσ
      have key2 := (mul_eq_zero.mp key).resolve_left hc
      rw [hinv, hinv, hRb, inv_neg]
      have e3 : (κ' m / κ m)⁻¹ * (ν' b / κ' b + ν a / κ a) =
          (κ' a / κ a)⁻¹ * (ν' b / κ' b + ν b / κ b) := by
        rw [inv_mul_eq_div, inv_mul_eq_div, div_eq_div_iff hRm hc]
        linear_combination key2
      rw [e3]
      ring

theorem pairI_swap {L : Submodule ℂ (Fin 5 × Fin 5 → ℂ)} (r r' : Fin 5) (h : PairI L r r') :
    PairI L r' r := by
  obtain ⟨κ, κ', ν, ν', a, b, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10⟩ := h
  refine ⟨κ', κ, ν', ν, b, a, h3, h4, h1, h2, fun t ht => ?_, by linear_combination h6, h8, h7,
    typeCl_swap κ κ' ν ν' h7 h8 a b h9, fun m hm => h10 m ⟨hm.2, hm.1⟩⟩
  linear_combination h5 t ht

