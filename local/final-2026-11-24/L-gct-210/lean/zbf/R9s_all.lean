    · exact Or.inr (Or.inr ⟨h.2.2.2.1, h.1, h.2.1⟩)
  obtain ⟨A1, hA1⟩ : ∃ A : ℂ, A = ∑ m ∈ B13, κ m := ⟨_, rfl⟩
