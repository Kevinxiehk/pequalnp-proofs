theorem s_transfer_aff {L : Submodule ℂ (Fin 5 × Fin 5 → ℂ)} (r1 r2 r3 : Fin 5) (h12 : r1 ≠ r2)
    (h13 : r1 ≠ r3) (h23 : r2 ≠ r3) (h0 : rowsZeroS L {r1, r2, r3} = ⊥) (κ κ2 κ3 : Fin 5 → ℂ)
    (hκ0 : ∀ m, κ m ≠ 0) (hκ20 : ∀ m, κ2 m ≠ 0) (hκ30 : ∀ m, κ3 m ≠ 0)
    (hκL : ∀ t ∈ L, dotL κ (rowMap r1 t) = 0) (hκ2L : ∀ t ∈ L, dotL κ2 (rowMap r2 t) = 0)
    (hκ3L : ∀ t ∈ L, dotL κ3 (rowMap r3 t) = 0) (hκ1 : dotL κ 1 = 1) (hκ21 : dotL κ2 1 = 1)
    (hκ31 : dotL κ3 1 = 1) (p q s : Fin 5) (hpq : p ≠ q) (hps : p ≠ s)
    (hqs : q ≠ s) :
    ∃ (rr cc : Fin 3 ⊕ Fin 2 ≃ Fin 5) (K : Fin 3 → Fin 5 → ℂ),
      rr (Sum.inl 0) = r1 ∧ rr (Sum.inl 1) = r2 ∧ rr (Sum.inl 2) = r3 ∧
      cc (Sum.inl 0) = p ∧ cc (Sum.inl 1) = q ∧ cc (Sum.inl 2) = s ∧
      K 0 = κ ∧ K 1 = κ2 ∧ K 2 = κ3 ∧
      (∀ t ∈ blkL L rr cc, (∀ i j, t (rr (Sum.inl i), cc (Sum.inl j)) = 0) → t = 0) ∧
      (∀ i m, K i m ≠ 0) ∧ (∀ i, ∀ t ∈ L, dotL (K i) (rowMap (rr (Sum.inl i)) t) = 0) ∧
      (∀ t ∈ blkL L rr cc, t ∈ L ∧ ∀ m, m ≠ p → m ≠ q → m ≠ s →
        t (r1, m) = 0 ∧ t (r2, m) = 0 ∧ t (r3, m) = 0) ∧
      (∀ i, dotL (K i) 1 = 1) ∧
      (∀ w ∈ blockSpace L rr cc, w.2 ∈ L ∧ ∀ m, m ≠ p → m ≠ q → m ≠ s →
        hat 5 w (r1, m) = 0 ∧ hat 5 w (r2, m) = 0 ∧ hat 5 w (r3, m) = 0) := by
  obtain ⟨rr, hr0, hr1, hr2⟩ := exists_equiv3 r1 r2 r3 h12 h13 h23
  obtain ⟨cc, hc0, hc1, hc2⟩ := exists_equiv3 p q s hpq hps hqs
  have zrow : ∀ m, m ≠ p → m ≠ q → m ≠ s → ∃ b0, cc (Sum.inr b0) = m := by
    intro m h1 h2 h3
    obtain ⟨y, rfl⟩ := cc.surjective m
    rcases y with i | b0
    · rcases fin3_cases i with rfl | rfl | rfl
      · exact absurd hc0 h1
      · exact absurd hc1 h2
      · exact absurd hc2 h3
    · exact ⟨b0, rfl⟩
  have hoff : ∀ t ∈ blkL L rr cc, ∀ m, m ≠ p → m ≠ q → m ≠ s →
      t (r1, m) = 0 ∧ t (r2, m) = 0 ∧ t (r3, m) = 0 := by
    intro t ht m h1 h2 h3
    obtain ⟨b0, rfl⟩ := zrow m h1 h2 h3
    have h := ((mem_blkL L rr cc t).mp ht).2
    refine ⟨?_, ?_, ?_⟩
    · rw [← hr0]
      exact h 0 b0
    · rw [← hr1]
      exact h 1 b0
    · rw [← hr2]
      exact h 2 b0
  obtain ⟨K, hK⟩ : ∃ K : Fin 3 → Fin 5 → ℂ, K = ![κ, κ2, κ3] := ⟨_, rfl⟩
  have hK0 : K 0 = κ := by first | (rw [hK]; rfl) | rw [hK]
  have hK1 : K 1 = κ2 := by first | (rw [hK]; rfl) | rw [hK]
  have hK2 : K 2 = κ3 := by first | (rw [hK]; rfl) | rw [hK]
  have h0' : ∀ t ∈ blkL L rr cc, (∀ i j, t (rr (Sum.inl i), cc (Sum.inl j)) = 0) → t = 0 := by
    intro t ht hz
    have htL := ((mem_blkL L rr cc t).mp ht).1
    have hmem : t ∈ rowsZeroS L {r1, r2, r3} := by
      refine ⟨htL, fun r hr m => ?_⟩
      have hri : ∃ i, rr (Sum.inl i) = r := by
        simp only [Finset.mem_insert, Finset.mem_singleton] at hr
        rcases hr with h | h | h
        · exact ⟨0, hr0.trans h.symm⟩
        · exact ⟨1, hr1.trans h.symm⟩
        · exact ⟨2, hr2.trans h.symm⟩
      obtain ⟨i, rfl⟩ := hri
      obtain ⟨y, rfl⟩ := cc.surjective m
      rcases y with i' | b0
      · exact hz i i'
      · exact ((mem_blkL L rr cc t).mp ht).2 i b0
    rw [h0] at hmem
    exact (Submodule.mem_bot ℂ).mp hmem
  refine ⟨rr, cc, K, hr0, hr1, hr2, hc0, hc1, hc2, hK0, hK1, hK2, h0', ?_, ?_,
    fun t ht => ⟨((mem_blkL L rr cc t).mp ht).1, hoff t ht⟩, ?_, fun w hw => ⟨((mem_blockSpace L rr cc w).mp hw).1,
    fun m h1 h2 h3 => ?_⟩⟩
  · intro i m
    rcases fin3_cases i with rfl | rfl | rfl
    · rw [hK0]
      exact hκ0 m
    · rw [hK1]
      exact hκ20 m
    · rw [hK2]
      exact hκ30 m
  · intro i t ht
    rcases fin3_cases i with rfl | rfl | rfl
    · rw [hK0, hr0]
      exact hκL t ht
    · rw [hK1, hr1]
      exact hκ2L t ht
    · rw [hK2, hr2]
      exact hκ3L t ht
  · intro i
    rcases fin3_cases i with rfl | rfl | rfl
    · rw [hK0]
      exact hκ1
    · rw [hK1]
      exact hκ21
    · rw [hK2]
      exact hκ31
  · obtain ⟨b0, rfl⟩ := zrow m h1 h2 h3
    have h := ((mem_blockSpace L rr cc w).mp hw).2
    refine ⟨?_, ?_, ?_⟩
    · rw [hat_apply, ← hr0]
      exact h 0 b0
    · rw [hat_apply, ← hr1]
      exact h 1 b0
    · rw [hat_apply, ← hr2]
      exact h 2 b0


theorem typeII_aff {L : Submodule ℂ (Fin 5 × Fin 5 → ℂ)} (κa κb : Fin 5 → ℂ) (B Q : Finset (Fin 5))
    (ra rb : Fin 5) (rel : ∀ t ∈ L, ∑ m ∈ B, t (ra, m) * κa m + ∑ m ∈ Q, t (rb, m) * κb m = 0)
    (w : ℂ × (Fin 5 × Fin 5 → ℂ)) (hwL : w.2 ∈ L) :
    ∑ m ∈ B, hat 5 w (ra, m) * κa m + ∑ m ∈ Q, hat 5 w (rb, m) * κb m =
      w.1 * (∑ m ∈ B, κa m + ∑ m ∈ Q, κb m) := by
  have e1 : ∑ m ∈ B, hat 5 w (ra, m) * κa m = w.1 * ∑ m ∈ B, κa m + ∑ m ∈ B, w.2 (ra, m) * κa m := by
    rw [Finset.mul_sum, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl (fun m _ => by rw [hat_apply]; ring)
  have e2 : ∑ m ∈ Q, hat 5 w (rb, m) * κb m = w.1 * ∑ m ∈ Q, κb m + ∑ m ∈ Q, w.2 (rb, m) * κb m := by
    rw [Finset.mul_sum, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl (fun m _ => by rw [hat_apply]; ring)
  rw [e1, e2]
  linear_combination rel w.2 hwL

theorem typeII_ite_aff (κa κb : Fin 5 → ℂ) (B Q : Finset (Fin 5)) (ra rb : Fin 5)
    (t : Fin 5 × Fin 5 → ℂ) (p q s : Fin 5) (hpq : p ≠ q) (hps : p ≠ s) (hqs : q ≠ s)
    (hoff : ∀ m, m ≠ p → m ≠ q → m ≠ s → t (ra, m) = 0 ∧ t (rb, m) = 0) (R : ℂ)
    (rel : ∑ m ∈ B, t (ra, m) * κa m + ∑ m ∈ Q, t (rb, m) * κb m = R) :
    (if p ∈ B then t (ra, p) * κa p else 0) + (if q ∈ B then t (ra, q) * κa q else 0) +
        (if s ∈ B then t (ra, s) * κa s else 0) +
      ((if p ∈ Q then t (rb, p) * κb p else 0) + (if q ∈ Q then t (rb, q) * κb q else 0) +
        (if s ∈ Q then t (rb, s) * κb s else 0)) = R := by
  have va : ∀ m, m ≠ p → m ≠ q → m ≠ s → t (ra, m) * κa m = 0 := fun m h1 h2 h3 => by
    rw [(hoff m h1 h2 h3).1, zero_mul]
  have vb : ∀ m, m ≠ p → m ≠ q → m ≠ s → t (rb, m) * κb m = 0 := fun m h1 h2 h3 => by
    rw [(hoff m h1 h2 h3).2, zero_mul]
  rw [← sum_C_three B p q s hpq hps hqs _ va, ← sum_C_three Q p q s hpq hps hqs _ vb]
  exact rel

theorem ksum_half (X j : ℂ) (hj : j * j = -1) (h : X * (1 + j) = 1) : X = (1 - j) / 2 := by
  linear_combination ((1 - j) / 2) * h + (X / 2) * hj

