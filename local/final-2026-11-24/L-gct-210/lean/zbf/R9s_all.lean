  have hb'B : b' ∈ B13 := (hB13 b').mpr rfl
  obtain ⟨hb'1, hb'2, hb'3, hb'4, hb'5, hb'6⟩ : b' ∉ Q12 ∧ b' ∉ B12 ∧ b' ∉ Q13 ∧ b' ∈ B13 ∧ b' ∉ Q23 ∧ b' ∈ B23 := by
