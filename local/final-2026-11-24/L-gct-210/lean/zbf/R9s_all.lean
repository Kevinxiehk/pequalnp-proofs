            · by_cases hm5 : m ∈ Q23
              · have hm6 : m ∉ B23 := hQB23 m hm5
                have hD := Hall m q s hm2 hm1 hq1 hs2
                simp only [hm1, hm2, hm3, hm4, hm5, hm6, hq1, hq2, hq3, hq4, hq5, hq6, hs1, hs2, hs3, hs4, hs5, hs6, not_true_eq_false, not_false_eq_true, true_and, and_true, false_and, and_false, or_false, false_or, or_self, and_self] at hD
              · by_cases hm6 : m ∈ B23
                · have hD := Hall m q s hm2 hm1 hq1 hs2
                  simp only [hm1, hm2, hm3, hm4, hm5, hm6, hq1, hq2, hq3, hq4, hq5, hq6, hs1, hs2, hs3, hs4, hs5, hs6, not_true_eq_false, not_false_eq_true, true_and, and_true, false_and, and_false, or_false, false_or, or_self, and_self] at hD
                · exact Or.inr (Or.inr (Or.inr (Or.inr (⟨hm1, hm2, hm3, hm4, hm5, hm6⟩))))
    rcases B1 wa with h | h | h | h | h
    · obtain ⟨hwa1, hwa2, hwa3, hwa4, hwa5, hwa6⟩ := h
      rcases B1 wb with h | h | h | h | h
      · simp only [hwb3, hwb4, not_true_eq_false, not_false_eq_true, true_and, and_true, false_and, and_false, or_false, false_or, or_self, and_self] at h
      · simp only [hwb3, hwb4, not_true_eq_false, not_false_eq_true, true_and, and_true, false_and, and_false, or_false, false_or, or_self, and_self] at h
      · obtain ⟨hwb1, hwb2, hwb3, hwb4, hwb5, hwb6⟩ := h
        have hD := Hall2 q wa wb hq4 hq3 hwa3 hwb4
        simp only [hq1, hq2, hq3, hq4, hq5, hq6, hwa1, hwa2, hwa3, hwa4, hwa5, hwa6, hwb1, hwb2, hwb3, hwb4, hwb5, hwb6, not_true_eq_false, not_false_eq_true, true_and, and_true, false_and, and_false, or_false, false_or, or_self, and_self] at hD
      · simp only [hwb3, hwb4, not_true_eq_false, not_false_eq_true, true_and, and_true, false_and, and_false, or_false, false_or, or_self, and_self] at h
      · simp only [hwb3, hwb4, not_true_eq_false, not_false_eq_true, true_and, and_true, false_and, and_false, or_false, false_or, or_self, and_self] at h
    · simp only [hwa3, hwa4, not_true_eq_false, not_false_eq_true, true_and, and_true, false_and, and_false, or_false, false_or, or_self, and_self] at h
    · simp only [hwa3, hwa4, not_true_eq_false, not_false_eq_true, true_and, and_true, false_and, and_false, or_false, false_or, or_self, and_self] at h
    · simp only [hwa3, hwa4, not_true_eq_false, not_false_eq_true, true_and, and_true, false_and, and_false, or_false, false_or, or_self, and_self] at h
    · simp only [hwa3, hwa4, not_true_eq_false, not_false_eq_true, true_and, and_true, false_and, and_false, or_false, false_or, or_self, and_self] at h

theorem f1_alg (j c c' A1 A2 A3 : ℂ) (hj : j * j = -1) (hc : c ≠ 0)
    (E1 : A1 + A2 + A3 = 1) (E2 : c * (j * A1 + A2 - A3) = 1) (E3 : c' * (A1 + j * A2 - A3) = 1)
    (E4 : (A3 + c * A2) * (1 + j) = 1) (E5 : (A3 + c' * A1) * (1 + j) = 1)
    (E6 : (c * A2 + c' * A1) * (1 + j) = 1) : False := by
  have e7 : 2 * A3 * (1 + j) = 1 := by linear_combination E4 + E5 - E6
  have hA3 : 4 * A3 = 1 - j := by linear_combination (1 - j) * e7 + 2 * A3 * hj
  have hX : 2 * (c * A2 - A3) = 0 := by
    linear_combination (1 - j) * E4 - (1 - j) * e7 + (c * A2 - A3) * hj
  have hcA2 : c * A2 = A3 := by linear_combination hX / 2
  have hY : 2 * (c' * A1 - A3) = 0 := by
    linear_combination (1 - j) * E5 - (1 - j) * e7 + (c' * A1 - A3) * hj
  have hc'A1 : c' * A1 = A3 := by linear_combination hY / 2
  have G1 : A3 * (j * c + c' - c * c') = c' := by
    linear_combination c' * E2 - c * j * hc'A1 - c' * hcA2
  have G2 : A3 * (c + j * c' - c * c') = c := by
    linear_combination c * E3 - c * hc'A1 - j * c' * hcA2
  have G3 : A3 * (c + c' + c * c') = c * c' := by
    linear_combination c * c' * E1 - c * hc'A1 - c' * hcA2
  have h8 : (c - c') * (A3 * (j - 1) + 1) = 0 := by linear_combination G1 - G2
  have h9 : A3 * (j - 1) + 1 ≠ 0 := by
    intro h
    have t : 2 * j + 4 = 0 := by linear_combination 4 * h - (j - 1) * hA3 + hj
    have t5 : (5 : ℂ) = 0 := by linear_combination ((2 - j) / 2) * t + hj
    norm_num at t5
  have hcc : c' = c := by
    have e := (mul_eq_zero.mp h8).resolve_right h9
    linear_combination -e
  rw [hcc] at G2 G3
  have K1 : A3 * (1 + j - c) = 1 := by
    have e : c * (A3 * (1 + j - c) - 1) = 0 := by linear_combination G2
    exact sub_eq_zero.mp ((mul_eq_zero.mp e).resolve_left hc)
  have K2 : A3 * (2 + c) = c := by
    have e : c * (A3 * (2 + c) - c) = 0 := by linear_combination G3
    exact sub_eq_zero.mp ((mul_eq_zero.mp e).resolve_left hc)
  have L1 : c * (1 - j) = -2 := by linear_combination -4 * K1 + (1 + j - c) * hA3 - hj
  have L2 : 4 * c = -2 * j := by linear_combination -4 * K2 + (2 + c) * hA3 + L1
  have t40 : (40 : ℂ) = 0 := by
    linear_combination (6 + 2 * j) * 4 * L1 - (6 + 2 * j) * (1 - j) * L2 - (6 + 2 * j) * 2 * hj +
      4 * hj
  norm_num at t40

theorem f1_alg2 (j c c' A1 A2 A3 : ℂ) (hj : j * j = -1)
    (E1 : A1 + A2 + A3 = 1) (E2 : c * (j * A1 + A2 - A3) = 1) (E3 : c' * (-A1 + A2 + j * A3) = 1)
    (E4 : (A3 + c * A2) * (1 + j) = 1) (E5 : (A1 + c' * A2) * (1 + j) = 1)
    (E6 : j * (c * A1 + c' * A3) * (1 + j) = 1) : False := by
  have G4 : 2 * A3 = 1 - j - 2 * c * A2 := by
    linear_combination (1 - j) * E4 + (A2 * c + A3) * hj
  have G5 : 2 * A1 = 1 - j - 2 * c' * A2 := by
    linear_combination (1 - j) * E5 + (A1 + A2 * c') * hj
  have H2 : c * (j + A2 * (1 + c - j * c')) = 1 := by
    linear_combination E2 + (c / 2) * hj + (c / 2) * G4 - (c * j / 2) * G5
  have H3 : c' * (j + A2 * (1 + c' - j * c)) = 1 := by
    linear_combination E3 + (c' / 2) * hj - (c' * j / 2) * G4 + (c' / 2) * G5
  have H6 : j * (c + c') - 2 * j * (1 + j) * c * c' * A2 = 1 := by
    linear_combination E6 - (j * (1 + j) * c / 2) * G5 - (j * (1 + j) * c' / 2) * G4 +
      (j * (c + c') / 2) * hj
  have F1 : A2 * (1 - c - c') = j := by
    linear_combination E1 + ((j - 1) / 2) * E4 + ((j - 1) / 2) * E5 +
      (-A1 / 2 - A2 * c / 2 - A2 * c' / 2 - A3 / 2) * hj
  have F2 : (c - c') * (j + A2 * (1 + c + c')) = 0 := by linear_combination H2 - H3
  rcases mul_eq_zero.mp F2 with hcc | hA
  · have hc' : c' = c := by linear_combination -hcc
    rw [hc'] at F1 H6 H2
    have G1c : A2 * (1 - 2 * c) = j := by linear_combination F1
    have H6c : 2 * j * c - 2 * j * (1 + j) * c ^ 2 * A2 = 1 := by linear_combination H6
    have t : (1 : ℂ) = 0 := by
      linear_combination (4*A2*c*j - 2*A2*c - 3*A2*j ^ 2 - 3*A2 - 8*c*j ^ 2 + 2*c*j - 6*c - 3*j ^ 3 -
        7*j ^ 2 - 4*j - 9) * G1c + (-6*A2*j ^ 2 - 4*A2*j - 4*A2 + 4*c*j ^ 2 + 4*c*j - 4*j ^ 2 - 12) * H2 +
        (3*A2*j - 4*A2 - 2*c*j + 2*c + 2*j + 6) * H6c +
        (3*A2 ^ 2 + A2 - 4*c ^ 2*j - 4*c*j + 2*c - 3*j ^ 2 - 7*j - 5) * hj
    norm_num at t
  · have h2 : 2 * A2 = 0 := by linear_combination F1 + hA
    have hA2 : A2 = 0 := by linear_combination h2 / 2
    rw [hA2] at F1
    have hj0 : j = 0 := by linear_combination -F1
    rw [hj0] at hj
    norm_num at hj

theorem sum_three_parts (S1 S2 S3 : Finset (Fin 5)) (f : Fin 5 → ℂ)
    (h : ∀ m, (m ∈ S1 ∧ m ∉ S2 ∧ m ∉ S3) ∨ (m ∉ S1 ∧ m ∈ S2 ∧ m ∉ S3) ∨
      (m ∉ S1 ∧ m ∉ S2 ∧ m ∈ S3)) :
    ∑ m, f m = ∑ m ∈ S1, f m + ∑ m ∈ S2, f m + ∑ m ∈ S3, f m := by
  have e : ∀ m, f m = (if m ∈ S1 then f m else 0) + (if m ∈ S2 then f m else 0) +
      (if m ∈ S3 then f m else 0) := by
    intro m
    rcases h m with ⟨h1, h2, h3⟩ | ⟨h1, h2, h3⟩ | ⟨h1, h2, h3⟩
    · rw [if_pos h1, if_neg h2, if_neg h3]
      ring
    · rw [if_neg h1, if_pos h2, if_neg h3]
      ring
    · rw [if_neg h1, if_neg h2, if_pos h3]
      ring
  calc ∑ m, f m = ∑ m, ((if m ∈ S1 then f m else 0) + (if m ∈ S2 then f m else 0) +
        (if m ∈ S3 then f m else 0)) := Finset.sum_congr rfl (fun m _ => e m)
    _ = ∑ m ∈ S1, f m + ∑ m ∈ S2, f m + ∑ m ∈ S3, f m := by
        rw [Finset.sum_add_distrib, Finset.sum_add_distrib, Finset.sum_ite_mem, Finset.sum_ite_mem,
          Finset.sum_ite_mem, Finset.univ_inter, Finset.univ_inter, Finset.univ_inter]

theorem sum_scale (S : Finset (Fin 5)) (f g : Fin 5 → ℂ) (k : ℂ) (h : ∀ m ∈ S, f m = k * g m) :
    ∑ m ∈ S, f m = k * ∑ m ∈ S, g m := by
  rw [Finset.mul_sum]
  exact Finset.sum_congr rfl h

theorem sum_one_eq (κ : Fin 5 → ℂ) (h : dotL κ 1 = 1) : ∑ m, κ m = 1 := by
  rw [dotL_apply] at h
  simp only [Pi.one_apply, one_mul] at h
  exact h

set_option maxHeartbeats 8000000 in
theorem orient1_noT0 {L : Submodule ℂ (Fin 5 × Fin 5 → ℂ)} (r1 r2 r3 : Fin 5)
    (κ κ2 κ3 : Fin 5 → ℂ) (hκ0 : ∀ m, κ m ≠ 0) (hκ20 : ∀ m, κ2 m ≠ 0) (hκ30 : ∀ m, κ3 m ≠ 0)
    (hκL : ∀ t ∈ L, dotL κ (rowMap r1 t) = 0) (hκ2L : ∀ t ∈ L, dotL κ2 (rowMap r2 t) = 0)
    (hκ3L : ∀ t ∈ L, dotL κ3 (rowMap r3 t) = 0) (hκ1 : dotL κ 1 = 1) (hκ21 : dotL κ2 1 = 1)
    (hκ31 : dotL κ3 1 = 1) (ν ν' μ μ' ξ ξ' : Fin 5 → ℂ) (a b a' b' a'' b'' : Fin 5)
    (hνL : ∀ t ∈ L, dotL ν (rowMap r1 t) + dotL ν' (rowMap r2 t) = 0)
    (hν1 : dotL ν 1 + dotL ν' 1 = 0)
    (hμL : ∀ t ∈ L, dotL μ (rowMap r1 t) + dotL μ' (rowMap r3 t) = 0)
    (hμ1 : dotL μ 1 + dotL μ' 1 = 0)
    (hξL : ∀ t ∈ L, dotL ξ (rowMap r2 t) + dotL ξ' (rowMap r3 t) = 0)
    (hξ1 : dotL ξ 1 + dotL ξ' 1 = 0)
    (hcl : TypeCl κ κ2 ν ν' a b) (hcl' : TypeCl κ κ3 μ μ' a' b')
    (hcl'' : TypeCl κ2 κ3 ξ ξ' a'' b'')
    (m0 : Fin 5) (hm01 : ν m0 / κ m0 = ν a / κ a) (hm02 : ν' m0 / κ2 m0 = ν' b / κ2 b)
    (m1 : Fin 5) (hm11 : μ m1 / κ m1 = μ a' / κ a') (hm12 : μ' m1 / κ3 m1 = μ' b' / κ3 b')
    (m2 : Fin 5) (hm21 : ξ m2 / κ2 m2 = ξ a'' / κ2 a'') (hm22 : ξ' m2 / κ3 m2 = ξ' b'' / κ3 b'')
    (B12 Q12 B13 Q13 B23 Q23 : Finset (Fin 5))
    (hB12 : ∀ m, m ∈ B12 ↔ ν m / κ m = ν b / κ b)
    (hQ12 : ∀ m, m ∈ Q12 ↔ ν' m / κ2 m = ν' a / κ2 a)
    (hB13 : ∀ m, m ∈ B13 ↔ μ m / κ m = μ b' / κ b')
    (hQ13 : ∀ m, m ∈ Q13 ↔ μ' m / κ3 m = μ' a' / κ3 a')
    (hB23 : ∀ m, m ∈ B23 ↔ ξ m / κ2 m = ξ b'' / κ2 b'')
    (hQ23 : ∀ m, m ∈ Q23 ↔ ξ' m / κ3 m = ξ' a'' / κ3 a'')
    (hO : Orient1 Q12 B12 Q13 B13 Q23 B23)
    (hno : ¬ ∃ m, m ∉ Q12 ∧ m ∉ B12 ∧ m ∉ Q13 ∧ m ∉ B13 ∧ m ∉ Q23 ∧ m ∉ B23) : False := by
  obtain ⟨hQB12, w12Q, w12B, sq12, -⟩ :=
    typeII_nf r1 r2 κ κ2 ν ν' a b hκL hκ2L hνL hκ0 hκ20 hcl B12 Q12 hB12 hQ12
  obtain ⟨hQB13, w13Q, w13B, sq13, -⟩ :=
    typeII_nf r1 r3 κ κ3 μ μ' a' b' hκL hκ3L hμL hκ0 hκ30 hcl' B13 Q13 hB13 hQ13
  obtain ⟨hQB23, w23Q, w23B, sq23, -⟩ :=
    typeII_nf r2 r3 κ2 κ3 ξ ξ' a'' b'' hκ2L hκ3L hξL hκ20 hκ30 hcl'' B23 Q23 hB23 hQ23

  have hT : ∀ m, (m ∉ Q12 ∧ m ∉ B12 ∧ m ∈ Q13 ∧ m ∉ B13 ∧ m ∈ Q23 ∧ m ∉ B23) ∨
      (m ∈ Q12 ∧ m ∉ B12 ∧ m ∉ Q13 ∧ m ∉ B13 ∧ m ∉ Q23 ∧ m ∈ B23) ∨
      (m ∉ Q12 ∧ m ∈ B12 ∧ m ∉ Q13 ∧ m ∈ B13 ∧ m ∉ Q23 ∧ m ∉ B23) := by
    intro m
    rcases hO m with h | h | h | h
    · exact absurd ⟨m, h⟩ hno
    · exact Or.inl h
    · exact Or.inr (Or.inl h)
    · exact Or.inr (Or.inr h)
  obtain ⟨c, hcdef⟩ : ∃ c : ℂ, c = κ2 a / κ a := ⟨_, rfl⟩
  obtain ⟨c', hc'def⟩ : ∃ c' : ℂ, c' = κ3 a' / κ a' := ⟨_, rfl⟩
  obtain ⟨c'', hc''def⟩ : ∃ c'' : ℂ, c'' = κ3 a'' / κ2 a'' := ⟨_, rfl⟩
  have hc : c ≠ 0 := by
    rw [hcdef]
    exact div_ne_zero (hκ20 a) (hκ0 a)
  have hc' : c' ≠ 0 := by
    rw [hc'def]
    exact div_ne_zero (hκ30 a') (hκ0 a')
  have hc'' : c'' ≠ 0 := by
    rw [hc''def]
    exact div_ne_zero (hκ30 a'') (hκ20 a'')
  rw [← hcdef] at w12Q w12B sq12
  rw [← hc'def] at w13Q w13B sq13
  rw [← hc''def] at w23Q w23B sq23
  have hm0B : m0 ∉ B12 := fun h => hcl.1 (hm01.symm.trans ((hB12 m0).mp h))
  have hm0Q : m0 ∉ Q12 := fun h => hcl.2.1 (((hQ12 m0).mp h).symm.trans hm02)
  obtain ⟨cJ, hcJdef⟩ : ∃ cJ : ℂ, cJ = κ2 m0 / κ m0 := ⟨_, rfl⟩
  have corner12 : ∀ m, m ∉ B12 → m ∉ Q12 → κ2 m = cJ * κ m := fun m h1 h2 => by
    have e := corner_unique κ κ2 ν ν' a b hcl m m0
      (corner_of_not κ κ2 ν ν' a b hcl m (fun h => h1 ((hB12 m).mpr h))
        (fun h => h2 ((hQ12 m).mpr h))) ⟨hm01, hm02⟩
    rw [hcJdef, ← e, div_mul_cancel₀ _ (hκ0 m)]
  obtain ⟨ω, hωdef⟩ : ∃ ω : ℂ, ω = κ3 m1 / κ m1 := ⟨_, rfl⟩
  have corner13 : ∀ m, m ∉ B13 → m ∉ Q13 → κ3 m = ω * κ m := fun m h1 h2 => by
    have e := corner_unique κ κ3 μ μ' a' b' hcl' m m1
      (corner_of_not κ κ3 μ μ' a' b' hcl' m (fun h => h1 ((hB13 m).mpr h))
        (fun h => h2 ((hQ13 m).mpr h))) ⟨hm11, hm12⟩
    rw [hωdef, ← e, div_mul_cancel₀ _ (hκ0 m)]
  obtain ⟨ω2, hω2def⟩ : ∃ ω2 : ℂ, ω2 = κ3 m2 / κ2 m2 := ⟨_, rfl⟩
  have corner23 : ∀ m, m ∉ B23 → m ∉ Q23 → κ3 m = ω2 * κ2 m := fun m h1 h2 => by
    have e := corner_unique κ2 κ3 ξ ξ' a'' b'' hcl'' m m2
      (corner_of_not κ2 κ3 ξ ξ' a'' b'' hcl'' m (fun h => h1 ((hB23 m).mpr h))
        (fun h => h2 ((hQ23 m).mpr h))) ⟨hm21, hm22⟩
    rw [hω2def, ← e, div_mul_cancel₀ _ (hκ20 m)]
  obtain ⟨j, hjdef⟩ : ∃ j : ℂ, j = cJ / c := ⟨_, rfl⟩
  have hcJ : cJ = j * c := by rw [hjdef, div_mul_cancel₀ _ hc]
  have hj : j * j = -1 := by
    have e := sq12 m0 hm0B hm0Q
    rw [← hcJdef] at e
    have e2 : (j * j + 1) * c ^ 2 = 0 := by linear_combination e - (cJ + j * c) * hcJ
    have e3 := (mul_eq_zero.mp e2).resolve_right (pow_ne_zero 2 hc)
    linear_combination e3
  have ha'Q : a' ∈ Q13 := (hQ13 a').mpr rfl
  obtain ⟨ha'1, ha'2, ha'3, ha'4, ha'5, ha'6⟩ : a' ∉ Q12 ∧ a' ∉ B12 ∧ a' ∈ Q13 ∧ a' ∉ B13 ∧ a' ∈ Q23 ∧ a' ∉ B23 := by
    rcases hT a' with h | h | h
    · exact h
    · exact absurd ha'Q h.2.2.1
    · exact absurd ha'Q h.2.2.1
  have R1 : c' = c'' * cJ := mul_right_cancel₀ (hκ0 a')
    (by linear_combination -(w13Q a' ha'Q) + w23Q a' ha'5 + c'' * corner12 a' ha'2 ha'1)
  have haQ : a ∈ Q12 := (hQ12 a).mpr rfl
  obtain ⟨ha1, ha2, ha3, ha4, ha5, ha6⟩ : a ∈ Q12 ∧ a ∉ B12 ∧ a ∉ Q13 ∧ a ∉ B13 ∧ a ∉ Q23 ∧ a ∈ B23 := by
    rcases hT a with h | h | h
    · exact absurd haQ h.1
    · exact h
    · exact absurd haQ h.1
  have R2 : ω = -c'' * c := mul_right_cancel₀ (hκ0 a)
    (by linear_combination -(corner13 a ha4 ha3) + w23B a ha6 + (-c'') * w12Q a haQ)
  have hbB : b ∈ B12 := (hB12 b).mpr rfl
  obtain ⟨hb1, hb2, hb3, hb4, hb5, hb6⟩ : b ∉ Q12 ∧ b ∈ B12 ∧ b ∉ Q13 ∧ b ∈ B13 ∧ b ∉ Q23 ∧ b ∉ B23 := by
    rcases hT b with h | h | h
    · exact absurd hbB h.2.1
    · exact absurd hbB h.2.1
    · exact h
  have R3 : -c' = ω2 * (-c) := mul_right_cancel₀ (hκ0 b)
    (by linear_combination -(w13B b hb4) + corner23 b hb6 hb5 + ω2 * w12B b hbB)
  have hω : ω = j * c' := by linear_combination R2 - j * R1 - c'' * j * hcJ - c'' * c * hj
  have hω2 : ω2 = j * c'' := by
    have e : (ω2 - j * c'') * c = 0 := by linear_combination R3 + R1 + c'' * hcJ
    exact sub_eq_zero.mp ((mul_eq_zero.mp e).resolve_right hc)
  have hpart : ∀ m, (m ∈ Q13 ∧ m ∉ Q12 ∧ m ∉ B12) ∨ (m ∉ Q13 ∧ m ∈ Q12 ∧ m ∉ B12) ∨
      (m ∉ Q13 ∧ m ∉ Q12 ∧ m ∈ B12) := by
    intro m
    rcases hT m with h | h | h
    · exact Or.inl ⟨h.2.2.1, h.1, h.2.1⟩
    · exact Or.inr (Or.inl ⟨h.2.2.1, h.1, h.2.1⟩)
    · exact Or.inr (Or.inr ⟨h.2.2.1, h.1, h.2.1⟩)
  obtain ⟨A1, hA1⟩ : ∃ A : ℂ, A = ∑ m ∈ Q13, κ m := ⟨_, rfl⟩
  obtain ⟨A2, hA2⟩ : ∃ A : ℂ, A = ∑ m ∈ Q12, κ m := ⟨_, rfl⟩
  obtain ⟨A3, hA3⟩ : ∃ A : ℂ, A = ∑ m ∈ B12, κ m := ⟨_, rfl⟩
