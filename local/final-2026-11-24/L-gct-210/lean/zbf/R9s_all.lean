      κs 2 (cc (Sum.inl 1)) * hat 5 w (rr (Sum.inl 2), cc (Sum.inl 1)) = w.1 * ((1 - j) / 2) ∧
      κs 2 (cc (Sum.inl 2)) * hat 5 w (rr (Sum.inl 2), cc (Sum.inl 2)) = w.1 * ((1 - j) / 2)) : False := by
