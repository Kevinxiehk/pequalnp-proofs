theorem redp_valsub (p : ℕ) (hp : p.Prime) :
    ∃ B : ValuationSubring ℂ, (p : ℂ) ∈ B.nonunits := by
  have hpA : (p : ℂ) ∈ (⊥ : Subring ℂ) := (Subring.mem_bot).2 ⟨p, by simp⟩
  have hI : Ideal.span {(⟨(p : ℂ), hpA⟩ : (⊥ : Subring ℂ))} ≠ ⊤ := by
    intro h
    have h1 : (1 : (⊥ : Subring ℂ)) ∈ Ideal.span {(⟨(p : ℂ), hpA⟩ : (⊥ : Subring ℂ))} := by
      rw [h]
      exact Submodule.mem_top
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.1 h1
    obtain ⟨m, hm⟩ := (Subring.mem_bot).1 a.2
    have h2 : (a : ℂ) * (p : ℂ) = 1 := congrArg Subtype.val ha
    rw [← hm] at h2
    have h3 : m * (p : ℤ) = 1 := by exact_mod_cast h2
    have h4 : (p : ℤ) ∣ 1 := ⟨m, by rw [mul_comm]; exact h3.symm⟩
    have h5 : p ∣ 1 := by exact_mod_cast h4
    exact hp.one_lt.ne' (Nat.dvd_one.1 h5)
  obtain ⟨B, -, hB⟩ := Ideal.image_subset_nonunits_valuationSubring _ hI
  exact ⟨B, hB ⟨⟨(p : ℂ), hpA⟩, Ideal.mem_span_singleton_self _, rfl⟩⟩

theorem proj_norm (B : ValuationSubring ℂ) {n : ℕ} (z : Fin n → ℂ) (hz : z ≠ 0) :
    ∃ k, z k ≠ 0 ∧ ∀ i, z i / z k ∈ B := by
  have hn : Nonempty (Fin n) := by
    by_contra h
    apply hz
    funext i
    exact (h ⟨i⟩).elim
  obtain ⟨k, hk⟩ := Finite.exists_max (fun i => B.valuation (z i))
  have hzk : z k ≠ 0 := by
    intro h0
    apply hz
    funext i
    have h1 := hk i
    simp only [h0, map_zero] at h1
    have h2 : (0 : B.ValueGroup) ≤ B.valuation (z i) := by
      first
      | exact zero_le'
      | exact zero_le _
      | simp
    exact (Valuation.zero_iff _).1 (le_antisymm h1 h2)
  refine ⟨k, hzk, fun i => ?_⟩
  apply B.mem_of_valuation_le_one
  have hv : B.valuation (z k) ≠ 0 := (Valuation.ne_zero_iff _).2 hzk
  rw [div_eq_mul_inv, map_mul, map_inv₀]
  calc B.valuation (z i) * (B.valuation (z k))⁻¹ ≤ B.valuation (z k) * (B.valuation (z k))⁻¹ := by
        first
        | exact mul_le_mul_left (hk i) _
        | exact mul_le_mul_right' (hk i) _
        | (gcongr; exact hk i)
    _ = 1 := mul_inv_cancel₀ hv

theorem unit_contra (B : ValuationSubring ℂ) (p : ℕ) (hB : (p : ℂ) ∈ B.nonunits) (g : B)
    (h : (1 : B) = p * g) : False := by
  have h1 : (1 : ℂ) = (p : ℂ) * (g : ℂ) := by
    have h0 := congrArg Subtype.val h
    simpa using h0
  rw [B.mem_nonunits_iff] at hB
  have h2 : B.valuation ((p : ℂ) * g) < 1 := by
    rw [map_mul]
    calc B.valuation (p : ℂ) * B.valuation (g : ℂ) ≤ B.valuation (p : ℂ) * 1 := by
          first
          | exact mul_le_mul_right (B.valuation_le_one g) _
          | exact mul_le_mul_left' (B.valuation_le_one g) _
          | (gcongr; exact B.valuation_le_one g)
      _ < 1 := by rw [mul_one]; exact hB
  rw [← h1, map_one] at h2
  exact lt_irrefl _ h2

